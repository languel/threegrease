{
  "name": "threegrease",
  "version": "0.1.0",
  "description": "Blender Grease Pencil implemented in three.js — foundation for an interactive action painting lab",
  "type": "module",
  "scripts": {
    "dev": "npm run ort-assets && vite",
    "build": "npm run ort-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ort-assets": "node scripts/copy-ort-assets.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@sparkjsdev/spark": "^2.1.0",
    "onnxruntime-web": "^1.27.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
